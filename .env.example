# Copy this file to .env for local development. Never put real secrets here.
AI_PROVIDER=openai
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_KEY=
AI_PROVIDER_TIMEOUT_SECONDS=20

# Provider forwarding remains governed by server-side policy.
GATEWAY_POLICY=AUTO
GATEWAY_FLAG_PROVIDER_ACTION=block
GATEWAY_DETECTORS=rules
GATEWAY_PUBLIC_DEMO=true
GATEWAY_API_KEYS={}
# Provider chat needs a separate gateway app key in GATEWAY_API_KEYS.
