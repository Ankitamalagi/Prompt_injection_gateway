# Reference values only. Set real values in your shell or deployment secret manager.
# The application reads process environment variables and does not load .env files itself.
AI_PROVIDER=none
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=your-model-name
OPENAI_API_KEY=
AI_PROVIDER_TIMEOUT_SECONDS=20

# Provider forwarding remains governed by server-side policy.
GATEWAY_POLICY=AUTO
GATEWAY_FLAG_PROVIDER_ACTION=block
GATEWAY_DETECTORS=rules
GATEWAY_PUBLIC_DEMO=true
